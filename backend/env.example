# Digi Setu AI Backend - Environment Configuration

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
ALLOWED_HOSTS=*

# Database
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/digi_setu_ai
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379

# AI Providers
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROK_API_KEY=your-grok-api-key-here

# AI Configuration
DEFAULT_AI_PROVIDER=openai
MAX_TOKENS=4000
TEMPERATURE=0.7

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,text/markdown

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
SENTRY_DSN=your-sentry-dsn-here

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Activity Streaming
ACTIVITY_STREAM_ENABLED=true
ACTIVITY_PRIVACY_MODE=true

# Tool Execution
ENABLE_TOOL_EXECUTION=true
TOOL_TIMEOUT=30

# Content Processing
ENABLE_CONTENT_ANALYSIS=true
MAX_CONTENT_LENGTH=100000
